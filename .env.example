# ============================================================
# Cycling AI Agent - Environment Configuration
# ============================================================
# Copy this file to the vault as config.env and fill in values.
#   cp .env.example ~/cycling-agent-data/config.env
# ============================================================

# --- Garmin Connect ---
# Garmin Connect API credentials for syncing wellness data.
# GARMIN_EMAIL and GARMIN_PASSWORD are your Garmin Connect login.
# GARMIN_TOKENSTORE is the path to a JSON file for caching auth tokens
# (created on first run; subsequent runs skip re-authentication).
GARMIN_EMAIL=your_email@example.com
GARMIN_PASSWORD=your_password
GARMIN_TOKENSTORE=~/cycling-agent-data/garmin_tokens.json

# --- LLM Settings ---
# OpenAI-compatible API (vLLM, Ollama, LM Studio, LocalAI, etc.)
# LLM_BASE_URL: Base URL including /v1 (e.g. http://localhost:8010/v1)
# LLM_API_KEY: API key (optional for local servers, required for remote)
# LLM_MODEL: Model name (e.g. qwen3.6-27b, llama3.1-8b)
LLM_BASE_URL=http://localhost:8010/v1
LLM_API_KEY=
LLM_MODEL=llama3.1-8b

# --- MQTT Settings ---
# MQTT broker for publishing training prescriptions.
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=cycling_agent/prescription

# --- Rider Biometrics ---
# Used for analytics calculations (TSS, IF, etc.).
RIDER_WEIGHT_KG=75.0
RIDER_FTP_WATTS=280
RIDER_MAX_HR=190
RIDER_RESTING_HR=45
RIDER_AGE=35