# Intervals.icu API credentials (personal API key from /settings)
INTERVALS_ICU_BASE_URL=https://intervals.icu
INTERVALS_ICU_API_KEY=
INTERVALS_ICU_API_SECRET=
INTERVALS_ICU_ATHLETE_ID=0

# Garmin Connect credentials (for direct HRV/RMSSD data)
GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_TOKENSTORE=

# Local LLM endpoint (Ollama default)
LLM_ENDPOINT=http://localhost:11434/api/generate
LLM_MODEL=llama3

# Rider biometrics
RIDER_WEIGHT_KG=

# MQTT (optional - for Home Assistant dashboard)
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=cycling/agent/prescription
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# LLM timeout in seconds
LLM_TIMEOUT=120